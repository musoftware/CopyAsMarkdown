{
  "name": "copy-as-markdown",
  "displayName": "Copy as Markdown",
  "description": "Copy multiple files or folders from VS Code explorer directly into formatted Markdown code blocks with relative paths.",
  "version": "0.1.4",
  "publisher": "mahmoudmu",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "copy",
    "prompt",
    "context",
    "llm",
    "code",
    "files"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/musoftware/CopyAsMarkdown"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:copy-as-markdown.copyFiles",
    "onCommand:copy-as-markdown.copyTree"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copy-as-markdown.copyFiles",
        "title": "Copy as Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "copy-as-markdown.copyTree",
        "title": "Copy Structure as Tree",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "copy-as-markdown.copyFiles",
          "group": "6_copypath@3"
        },
        {
          "command": "copy-as-markdown.copyTree",
          "group": "6_copypath@4"
        }
      ],
      "editor/context": [
        {
          "command": "copy-as-markdown.copyFiles",
          "group": "6_copypath@3"
        },
        {
          "command": "copy-as-markdown.copyTree",
          "group": "6_copypath@4"
        }
      ],
      "editor/title": [
        {
          "command": "copy-as-markdown.copyFiles",
          "group": "navigation"
        },
        {
          "command": "copy-as-markdown.copyTree",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Copy as Markdown",
      "properties": {
        "copyAsMarkdown.treeFormat": {
          "type": "string",
          "enum": [
            "markdownBlock",
            "plainText"
          ],
          "default": "markdownBlock",
          "description": "Format for copied structure tree: 'markdownBlock' (wrapped in ```text code block) or 'plainText' (raw ASCII text)."
        },
        "copyAsMarkdown.includeFileNameAsHeader": {
          "type": "boolean",
          "default": true,
          "description": "Include relative file path as an h3 header (### `path/to/file.ext`)."
        },
        "copyAsMarkdown.includeFileTree": {
          "type": "boolean",
          "default": false,
          "description": "Include an ASCII directory tree summary of copied files at the top."
        },
        "copyAsMarkdown.includeLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Include line numbers before each line in code blocks."
        },
        "copyAsMarkdown.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "description": "Maximum file size in KB to read (files exceeding this limit will be skipped)."
        },
        "copyAsMarkdown.ignoredFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".DS_Store",
            "Thumbs.db",
            "desktop.ini",
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml"
          ],
          "description": "List of file names or patterns to ignore when collecting files (e.g. .DS_Store, Thumbs.db, package-lock.json, *.log)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
